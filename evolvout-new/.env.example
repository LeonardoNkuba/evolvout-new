# Email Configuration
# Resend (Recommended - free tier available)
RESEND_API_KEY=your_resend_api_key_here

# Contact email where messages will be sent
CONTACT_EMAIL=contacto@evolvout.com

# Verified sender address used by Resend
CONTACT_FROM_EMAIL=noreply@evolvout.com

# Alternative: SendGrid
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# Alternative: Gmail + Nodemailer
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password

# Node Environment
NODE_ENV=development
